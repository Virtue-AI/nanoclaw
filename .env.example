# Claude API (one required)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...

# NanoClaw Guard (optional — without these, only critical regex patterns are enforced)
# GUARD_API_TOKEN=your-jwt-token
# GUARD_POLICY_ID=your-policy-id
# GUARD_API_URL=https://virtueagent-action-guard.ngrok.io
# GUARD_FAST_MODE=true
# GUARD_ENABLED=true
# GUARD_DEBUG=false
# FEEDBACK_URL=
# FEEDBACK_TOKEN=

# VirtueAI MCP Gateway (optional — gives agents access to HR, Slack, Gmail, etc.)
# Run `npm run auth:gateway` to authenticate, or set manually:
# MCP_GATEWAY_URL=https://virtueai-agent-gtw-xxx.ngrok.io/mcp
# MCP_GATEWAY_ACCESS_TOKEN=eyJ...   (OAuth access token, set by auth:gateway)
# MCP_GATEWAY_REFRESH_TOKEN=eyJ...  (OAuth refresh token, set by auth:gateway)
# MCP_GATEWAY_CLIENT_ID=...         (OAuth client ID, set by auth:gateway)
